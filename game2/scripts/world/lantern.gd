class_name Lantern
extends OmniLight3D
## ЛОКАЛЬНЫЙ ИСТОЧНИК СВЕТА ЭПОХИ. До этого файла во всём game2 был НОЛЬ
## точечных источников — проверено поиском по OmniLight3D/SpotLight3D. Светили
## только Солнце, Луна и небо, то есть три источника на бесконечности, и ни
## одного, до которого можно дойти.
##
## ПОЧЕМУ ЭТО ОКАЗАЛОСЬ ВАЖНЕЕ, ЧЕМ КАЗАЛОСЬ. Разобрав два чужих ролика по
## числам (studio/density.py), я получил одну и ту же величину дважды: у GTA 6 в
## сухую ночь в кадре 47.7 раздельных источника, у любительского уровня на
## Unreal — 4 (один фонарь в руке), у нас 0. При этом уровень на Unreal собран
## из НЕТЕКСТУРИРОВАННЫХ белых коробок, и всё равно читается плотнее нашего:
## 86% его кадра темнее 0.10 яркости, и один конус фонаря даёт градиент на
## каждой поверхности, по которому глаз читает форму и материал. Ровный свет со
## всего неба не даёт градиента ни на чём.
##
## ЧТО ИМЕННО СВЕТИЛО В ГАТЧИНЕ 1894 ГОДА — установлено, не выдумано.
## Уличное освещение города в начале 1890-х — КЕРОСИНОВОЕ, 3500 рублей в год на
## район. Электрические дуговые фонари с 1881 года стояли только на площади
## перед дворцом (16 свечей Яблочкова, 25 ноября ст.ст. 1881 — первое в России
## наружное электрическое освещение). Городскую электрическую сеть в это время
## только пытались заказать: 22 июня 1893 инженер Н.А. Демчинский предложил 72
## уличных дуговых фонаря и 420 ламп накаливания в зданиях; с 1 октября 1893
## работала опытная установка (паровая машина ~70 л.с., динамо 42 кВт); в конце
## декабря 1893 — расширенный проект на 84 фонаря за 18 970 рублей в год; тендер
## 1894–1895 закончился ничем — в марте 1895 всё отложили на неопределённый срок.
## Источник: Российское историческое общество, historyrussia.org, «Попытка
## заключения контракта на создание системы уличного городского освещения
## Гатчины в конце XIX века».
## ЗНАЧИТ: в 1894 на улицах города — керосин, у дворца — дуга, в домах — свечи и
## керосиновые лампы. Электрической лампочки в окне обывателя быть не может.
##
## СИЛА СВЕТА — В КАНДЕЛАХ, и вот что здесь ИЗМЕРЕНО, а что ПРЕДПОЛОЖЕНО.
## ИЗМЕРЕНО (документально, ссылка выше): тип источника и место, где он стоял.
## ПРЕДПОЛОЖЕНИЕ: сами канделы. Взяты из общего знания о таких источниках и НЕ
## проверены по источнику. Порядок величины надёжен (свеча — единицы, лампа —
## десятки, дуга — сотни), точное число — нет. Если найдётся справочник по
## силе света керосиновых горелок в свечах, эти числа надо заменить.

## Перевод канделы → энергия Godot. НЕ подгонка: это та же шкала, по которой
## светит Солнце. Часы дают Солнцу light_energy 4.20 при 101 клк, отсюда
## WeatherSky.AMB_PER_KLX = 0.0416 энергии на килолюкс. Источник силой I кандел
## создаёт на расстоянии d освещённость I/d² люкс = I/d²/1000 клк. При
## omni_attenuation = 2.0 Godot делит энергию ровно на d², поэтому
##     энергия = I * 0.0416 / 1000
## и дальше обратный квадрат считает движок. Никакого «подкрутить на глаз».
const ENERGY_PER_CD := WeatherSky.AMB_PER_KLX / 1000.0

## Ниже этой освещённости источник перестаёт что-либо добавлять к кадру, и
## дальше его считать — только тратить заполнение пикселей. 0.05 люкс примерно
## соответствует свету полной Луны: за этой границей источник уже не главный.
const CUTOFF_LUX := 0.05

# Каталог: [сила света, кандел | цветовая температура, K | дрожание 0..1 | частота, Гц]
# Цветовые температуры пламени — величины физические и надёжные: пламя свечи и
# керосина 1800–1900 K (жёлто-оранжевое), вольтова дуга около 3800 K на угле
# (почти белая, с заметным ультрафиолетом — отсюда жалобы на резь в глазах).
const KINDS := {
	# в доме
	"свеча":        [1.0, 1850.0, 0.22, 7.0],     # одна стеариновая свеча
	"лампада":      [0.4, 1800.0, 0.16, 5.0],
	"канделябр5":   [5.0, 1850.0, 0.12, 7.0],     # пять свечей: дрожание усредняется
	"лампа10":      [12.0, 1900.0, 0.07, 4.0],    # керосиновая, 10-линейная горелка
	"лампа20":      [30.0, 1900.0, 0.06, 4.0],    # 20-линейная, «молния»
	# на улице
	"фонарь_ручной": [3.0, 1900.0, 0.14, 6.0],    # «летучая мышь», в руке
	"фонарь_улич":  [16.0, 1900.0, 0.09, 4.0],    # керосиновый уличный, на столбе
	# у дворца — только там
	"дуга":         [450.0, 3800.0, 0.05, 100.0], # дуговая лампа, гудит и мерцает
}


var kind: String = "лампа10"
var cd: float = 12.0
var _flick_amp: float = 0.0
var _flick_hz: float = 4.0
var _base_energy: float = 0.0
var _t: float = 0.0
var _seed: float = 0.0


## Собрать источник по названию из каталога. Всё остальное считается отсюда.
static func make(what: String) -> Lantern:
	var l := Lantern.new()
	l.setup(what)
	return l


func setup(what: String) -> void:
	if not KINDS.has(what):
		push_warning("[фонарь] нет такого источника: %s" % what)
		what = "лампа10"
	kind = what
	var k: Array = KINDS[what]
	cd = float(k[0])
	_flick_amp = float(k[2])
	_flick_hz = float(k[3])
	_seed = randf() * 100.0

	_base_energy = cd * ENERGY_PER_CD
	light_energy = _base_energy
	light_color = _color_from_kelvin(float(k[1]))
	# ОБРАТНЫЙ КВАДРАТ. По умолчанию Godot ставит 1.0 — это не физика, а кривая
	# «на глаз», и с ней расстояние перестаёт значить то, что значит.
	omni_attenuation = 2.0
	# Дальность из самой силы света, а не из вкуса: d = sqrt(I / E_порог).
	omni_range = sqrt(cd / CUTOFF_LUX)
	# Тень от одного пламени — мягкая: горелка это не точка, а язык огня
	# сантиметров в пять. Для дуги пятно меньше и тень резче.
	shadow_enabled = true
	light_size = 0.02 if what == "дуга" else 0.06
	shadow_bias = 0.02
	# Свет свечи в объёме воздуха виден как ореол — это и есть половина эффекта.
	light_volumetric_fog_energy = 1.0


func _process(dt: float) -> void:
	# ДРОЖАНИЕ ПЛАМЕНИ. Не украшение: неподвижный источник читается лампочкой, а
	# не огнём, и это первое, что выдаёт подделку. Две несоизмеримые синусоиды
	# вместо шума — дёшево и не даёт периодичности, слышимой глазом.
	if _flick_amp <= 0.0:
		return
	_t += dt
	var a := sin((_t + _seed) * TAU * _flick_hz)
	var b := sin((_t + _seed) * TAU * _flick_hz * 0.37 + 1.7)
	light_energy = _base_energy * (1.0 + _flick_amp * (a * 0.6 + b * 0.4))


## Освещённость в люксах, которую этот источник даёт на расстоянии d.
## Нужна для проверки числом, а не для рендера.
func lux_at(d: float) -> float:
	return cd / maxf(d * d, 1.0e-6)


## Цвет по температуре пламени (приближение Таннера Хелланда, нормировано так,
## что самый сильный канал равен 1: яркость задаёт энергия, а не цвет).
static func _color_from_kelvin(k: float) -> Color:
	var t := clampf(k, 1000.0, 40000.0) / 100.0
	var r := 255.0
	var g := 255.0
	var b := 255.0
	if t <= 66.0:
		g = 99.4708025861 * log(t) - 161.1195681661
		b = 0.0 if t <= 19.0 else 138.5177312231 * log(t - 10.0) - 305.0447927307
	else:
		r = 329.698727446 * pow(t - 60.0, -0.1332047592) * 255.0 / 255.0
		g = 288.1221695283 * pow(t - 60.0, -0.0755148492)
	var c := Vector3(clampf(r, 0.0, 255.0), clampf(g, 0.0, 255.0), clampf(b, 0.0, 255.0)) / 255.0
	var m := maxf(maxf(c.x, c.y), maxf(c.z, 1.0e-4))
	c /= m
	return Color(c.x, c.y, c.z)


## САМОПРОВЕРКА ЧИСЛАМИ. Печатает, на каком расстоянии каждый источник равен
## по силе ночному свету неба — то есть где он ещё главный, а где уже нет.
static func self_test() -> void:
	var glow_klx: float = WeatherSky.NIGHT_GLOW / WeatherSky.AMB_PER_KLX
	var glow_lux: float = glow_klx * 1000.0
	print("[фонарь] ночное свечение неба заложено как %.4f клк = %.2f лк" % [glow_klx, glow_lux])
	for name_ in KINDS:
		var k: Array = KINDS[name_]
		var i: float = float(k[0])
		# где источник сравнивается с фоном: I/d² = фон
		var d_eq: float = sqrt(i / maxf(glow_lux, 1.0e-6))
		print("  %-14s %6.1f кд | %5.0f K | на 1 м %7.1f лк | равен фону на %.2f м | дальность %.1f м"
			% [name_, i, float(k[1]), i, d_eq, sqrt(i / CUTOFF_LUX)])
