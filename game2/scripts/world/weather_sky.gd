class_name WeatherSky
extends RefCounted
## КОГЕРЕНТНАЯ ПОГОДА: одно число — покрытие облаков — управляет ВСЕМ небом.
## Не «крашеная серая крыша»: ясное физ-небо синее, а пасмурность рождается
## из ПЛОТНЫХ ОБЛАКОВ (coverage→высокое) и этим же гасится/сереет свет.
## Один источник правды для игры (light_stage) и стенда (sky_probe).

# ЭНЕРГИЯ НА КИЛОЛЮКС — ОДНА И ТА ЖЕ ДЛЯ СОЛНЦА, ЗЕМЛИ И ОБЛАКОВ, и она не
# выдумана: часы дают Солнцу light_energy 4.20 при луче 101 клк, то есть 0.0416
# на клк. Всё, что светится от неба, обязано считаться по этой же шкале, иначе
# доля рассеянного света в кадре не имеет отношения к физике.
const AMB_PER_KLX := 0.0416
# НОЧНОЕ СВЕЧЕНИЕ — СЛАГАЕМОЕ, А НЕ ПОЛ (пол делал поздние сумерки ярче ранних).
#
# БЫЛО 0.004, и это оказалось главной причиной, по которой ночь у нас не ночь.
# 0.004 / AMB_PER_KLX = 0.096 клк = 96 люкс. Девяносто шесть люкс — это свет в
# конторском коридоре. Настоящая безлунная ночь даёт у земли около 0.002 лк,
# полнолуние — около 0.25 лк. То есть заложено было в сорок тысяч раз больше
# полной Луны.
#
# ИЗМЕРЕНО, ЧЕМ ЭТО ВЫШЛО. Я поставил в кадр керосиновую лампу — настоящую,
# 12 кандел (Lantern, «лампа10»). На расстоянии вытянутой руки она даёт 12 лк,
# то есть В ВОСЕМЬ РАЗ МЕНЬШЕ этого фона. Кадр до лампы и после неё: яркость
# 0.085 → 0.086, край 0.040 → 0.040, цветов 228 → 226. Лампы в кадре нет вообще.
# Никакой источник эпохи — ни свеча, ни фонарь, ни даже дуговая лампа за
# несколько метров — не мог пробиться сквозь этот фон. Ночь была залита ровным
# светом ниоткуда, и потому в ней ничего нельзя было построить.
#
# СТАЛО 1.25e-5 = 3.0e-4 клк = 0.30 люкс, чуть ярче полнолуния. Это по-прежнему
# РЕШЕНИЕ, а не физика (честная безлунная ночь — чёрный экран, палочкового
# зрения у нас нет), но теперь у решения есть проверяемое условие:
#   СВЕЧЕНИЕ НЕБА ОБЯЗАНО БЫТЬ СЛАБЕЕ ИСТОЧНИКА ЭПОХИ НА РАБОЧЕМ РАССТОЯНИИ.
# Керосиновая лампа на 2 м даёт 3 лк — вдесятеро больше фона; свеча на 1 м даёт
# 1 лк — втрое больше. Значит источник в кадре главный, а это и есть условие,
# при котором свет вообще может что-то лепить.
# Луна сюда не входит: она добавляется отдельным слагаемым в _apply_skylight.
const NIGHT_GLOW := 1.25e-5
# Рассеянный свет неба в полдень 21 июня в Гатчине: полная горизонтальная 95 клк
# минус прямая 80 клк. Опора, от которой считаются ДОЛИ (облака).
const SKY_REF_KLX := 14.8

## пасмурность 0..1 из покрытия: ясно/переменка → 0 (солнечно),
## плотная облачность → 1 (ровный серый свет). Порог — реальный: свет сереет
## только когда небо реально затянуто, а не при редких кучевых.
static func overcast_from_coverage(cov: float) -> float:
	return smoothstep(0.45, 0.82, cov)

## небо: интерполяция ЯСНОЕ(синее) ↔ ПАСМУРНОЕ(ровный серый) по пасмурности oc
static func apply_sky(sm: PhysicalSkyMaterial, oc: float) -> void:
	sm.rayleigh_coefficient = lerpf(2.0, 0.9, oc)
	sm.rayleigh_color = Color(0.26, 0.41, 0.58).lerp(Color(0.55, 0.58, 0.62), oc)
	sm.mie_coefficient = lerpf(0.005, 0.09, oc)
	sm.mie_eccentricity = lerpf(0.80, 0.55, oc)
	sm.mie_color = Color(0.69, 0.80, 0.92).lerp(Color(0.86, 0.88, 0.90), oc)
	sm.turbidity = lerpf(2.5, 10.0, oc)
	# ДИСК СОЛНЦА НАСТОЯЩЕГО РАЗМЕРА. Godot берёт видимый размер диска как
	# угол света × sun_disk_scale. Свету мы даём НАМЕРЕННО МАЛЫЙ угол (0.20°),
	# чтобы тень была собранной и не дрожала, поэтому здесь домножаем обратно:
	# 0.53 / 0.20 = 2.65 — и в небе снова настоящие 0.53°.
	sm.sun_disk_scale = lerpf(2.65, 0.0, oc)         # диск гаснет за облачностью
	sm.energy_multiplier = lerpf(1.0, 1.5, oc)
	sm.ground_color = Color(0.30, 0.30, 0.31)

## ГРУБЫЙ ДВУХЦВЕТНЫЙ КУПОЛ: [у горизонта, в зените], линейные величины.
## Нужен ровно в одном месте — воде, когда отражённый луч ушёл за край кадра И
## неба в кадре нет вовсе (смотрим круто вниз). Там Френель даёт 2-10%, поэтому
## грубости хватает; настоящее небо вода берёт из самого кадра.
## Цвета взяты из тех же величин, что ведут PhysicalSkyMaterial выше: рэлеевское
## рассеяние красит зенит синим и слабеет с облачностью, ми-рассеяние белит
## горизонт и с облачностью растёт. Яркость — по высоте Солнца.
static func sky_colors(oc: float, sun_el_deg: float) -> Array:
	# сумерки не обрываются в ноль: даже при Солнце под горизонтом небо светится
	var day := clampf(sin(deg_to_rad(maxf(sun_el_deg, -6.0))) + 0.10, 0.02, 1.0)
	var zen := Color(0.26, 0.41, 0.58).lerp(Color(0.55, 0.58, 0.62), oc)
	var hor := Color(0.69, 0.80, 0.92).lerp(Color(0.86, 0.88, 0.90), oc)
	var e := day * lerpf(1.0, 0.75, oc)
	return [Vector3(hor.r, hor.g, hor.b) * e, Vector3(zen.r, zen.g, zen.b) * e]

## ЭКСПОЗИЦИЯ С ПРИСПОСОБЛЕНИЕМ ГЛАЗА К ТЕМНОТЕ.
##
## ИЗМЕРЕНО, что было неверно: экспозиция зависела ТОЛЬКО от облачности, а свет
## за сутки меняется в миллион раз — полдень около 100 000 лк, полнолуние 0.25 лк,
## одни звёзды 0.001 лк. С дневной экспозицией ночь неизбежно выходит ЧЁРНОЙ:
## снимок в 22:15 дал среднюю яркость кадра 0.126, а нижние четыре пятых кадра —
## ровно ноль. Отсюда и «чёрная полоса в воде»: вода честно отражала чёрный
## берег, и полоса росла при движении вместе с линией горизонта.
##
## Глаз так не работает: за полчаса темноты он поднимает чувствительность
## примерно в тысячу раз (палочковое зрение). Это и делается здесь — не
## «подсветкой ночи» фальшивым источником, а тем же приёмом, что у глаза и у
## фотоаппарата: подъёмом чувствительности по мере ухода Солнца.
##   выше 3°   — день, приспособления нет;
##   0..-6°    — гражданские сумерки, чувствительность растёт вчетверо;
##   -6..-12°  — навигационные, ещё вчетверо;
##   ниже -12° — ночь, всего в 24 раза против дня.
## Дальше картину держит настоящий свет Луны и звёзд, а не выдуманная добавка.
static func night_gain(sun_el_deg: float) -> float:
	if sun_el_deg >= 3.0:
		return 1.0
	if sun_el_deg >= -6.0:
		return lerpf(1.0, 4.0, (3.0 - sun_el_deg) / 9.0)
	if sun_el_deg >= -12.0:
		return lerpf(4.0, 16.0, (-6.0 - sun_el_deg) / 6.0)
	return 24.0

## экспозиция и сила рассеянного света неба по пасмурности (для Environment)
static func exposure(oc: float) -> float:
	return lerpf(0.95, 0.82, oc)

static func ambient_energy(oc: float) -> float:
	# ИЗМЕРЕНО, что было неверно: рассеянный свет РОС с облачностью (1.25 -> 2.10)
	# ровно настолько, насколько гасло прямое Солнце (1.00 -> 0.22). Суммарный
	# свет при этом не падал совсем: 2.25 против 2.32. В жизни ясный день даёт
	# около 110 клк, сплошная облачность — около 20 клк, впятеро меньше.
	# Из-за этого пасмурный день выглядел плоской бестеневой засветкой, и земля
	# «белела».
	# Физически: при облачности небо становится РАВНОМЕРНЫМ излучателем, и его
	# собственный вклад чуть выше, чем у ясного синего неба (10-20 клк против
	# 15-25 клк) — но прямое Солнце исчезает, и общий свет всё равно падает.
	return lerpf(1.25, 1.45, oc)
