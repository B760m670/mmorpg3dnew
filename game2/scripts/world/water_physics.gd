# Имя класса НЕ объявляем: подключаемся через preload (см. walker.gd).
extends RefCounted
## ВОДА КАК ВЕЩЕСТВО, а не как поверхность.
##
## Здесь нет ничего про то, как вода ВЫГЛЯДИТ. Здесь только то, что она ДЕЛАЕТ
## с телом, которое в неё вошло: держит его (плотность), тормозит его (вязкость
## и лобовое сопротивление), и разносит от него круги (волновое уравнение).
##
## ЗАЧЕМ ОТДЕЛЬНЫМ ФАЙЛОМ. До этого вода была плёнкой: MeshInstance3D с плоским
## полигоном, без единого CollisionShape3D и без Area3D. В walker.gd слова
## «вода» не было вовсе — зайти в озеро значило идти по дну посуху на полной
## скорости. Оптику можно довести до идеала, и это всё равно останется наклейкой,
## пока вода ничего не делает.
##
## ЧЕГО ЗДЕСЬ НЕТ И НЕ БУДЕТ: объёмного расчёта жидкости (SPH/FLIP). Его нет и
## в AAA — ни в RDR2, ни в TLoU2, ни в Horizon озеро не считается как жидкость,
## объёмный расчёт там идёт только на мелкие эффекты. Настоящее в их воде —
## ровно то, что ниже: архимедова сила, сопротивление и волновое уравнение.

const G := 9.81
## плотность пресной воды при 10 °C (средняя летняя температура озера в
## Ленинградской области на глубине), кг/м³
const RHO := 999.7
## кинематическая вязкость воды при 10 °C, м²/с. Нужна для числа Рейнольдса:
## по нему видно, что режим обтекания ноги — турбулентный, и коэффициент
## сопротивления надо брать постоянным, а не по закону Стокса.
const NU := 1.306e-6
## средняя плотность человека с воздухом в лёгких, кг/м³. МЕНЬШЕ воды — поэтому
## человек всплывает; это и есть причина, по которой на глубине пропадает опора.
const RHO_BODY := 985.0

## Коэффициент лобового сопротивления. Нога и туловище при скорости порядка
## 1 м/с и поперечнике 0.15-0.4 м дают Re = v·d/ν ≈ 1.1·10⁵ — развитая
## турбулентность, где Cd цилиндра держится около 1.1 и от скорости не зависит.
const CD := 1.1

## Продольное усилие, которое человек может держать при ходьбе, доля от веса.
## Пиковая горизонтальная реакция опоры при ходьбе — около 0.25 веса, но
## УДЕРЖИВАЕМАЯ (не пиковая) составляющая около 0.18. Это и есть то, чем
## человек продавливает воду.
const PUSH_FRAC := 0.18

## Тело: рост 1.75 м, масса 70 кг. Профиль задан таблицей по высоте:
##   высота, м | ФРОНТАЛЬНАЯ ширина, м | доля объёма тела НИЖЕ этой высоты
## Ширина нужна для площади, о которую бьётся вода; доля объёма — для
## архимедовой силы. Значения — обычная антропометрия взрослого мужчины:
## две ноги по 0.15 м, таз 0.34, плечи 0.44, шея/голова узкие.
const BODY_H := 1.75
const BODY_M := 70.0
const PROF_Y := [0.00, 0.45, 0.85, 1.05, 1.45, 1.62, 1.75]
const PROF_W := [0.30, 0.32, 0.34, 0.36, 0.44, 0.20, 0.16]
const PROF_V := [0.00, 0.14, 0.32, 0.47, 0.87, 0.94, 1.00]

## полный объём тела: из массы и плотности, а не из мерки
static func body_volume() -> float:
	return BODY_M / RHO_BODY                       # 0.0711 м³

## ФРОНТАЛЬНАЯ ПЛОЩАДЬ погружённой части, м². Интеграл ширины по высоте.
static func frontal_area(h: float) -> float:
	var s := 0.0
	for i in range(PROF_Y.size() - 1):
		var y0: float = PROF_Y[i]
		var y1: float = PROF_Y[i + 1]
		if h <= y0:
			break
		var top: float = minf(h, y1)
		var t: float = (top - y0) / (y1 - y0)
		var w1: float = lerpf(PROF_W[i], PROF_W[i + 1], t)
		s += 0.5 * (PROF_W[i] + w1) * (top - y0)
	return s

## доля объёма тела, оказавшаяся под водой при погружении h
static func submerged_frac(h: float) -> float:
	if h <= 0.0:
		return 0.0
	if h >= BODY_H:
		return 1.0
	for i in range(PROF_Y.size() - 1):
		if h <= PROF_Y[i + 1]:
			var t: float = (h - PROF_Y[i]) / (PROF_Y[i + 1] - PROF_Y[i])
			return lerpf(PROF_V[i], PROF_V[i + 1], t)
	return 1.0

## АРХИМЕДОВА СИЛА при погружении h, Н
static func buoyancy(h: float) -> float:
	return RHO * G * body_volume() * submerged_frac(h)

## Какая доля веса ещё лежит на ногах. Когда она мала, сцепления с дном нет:
## оттолкнуться нечем, и человек переходит на плавание.
static func foot_load(h: float) -> float:
	var w := BODY_M * G
	return clampf((w - buoyancy(h)) / w, 0.0, 1.0)

## ПРЕДЕЛЬНАЯ СКОРОСТЬ БРОДА, м/с. Установившееся движение: толкающее усилие
## равно лобовому сопротивлению  F = ½·ρ·Cd·A·v²  →  v = sqrt(2F/(ρ·Cd·A)).
## Усилие, кроме того, падает вместе с нагрузкой на ноги: по воде нельзя
## оттолкнуться сильнее, чем позволяет трение о дно.
static func wade_speed(h: float) -> float:
	var a := frontal_area(h)
	if a < 1e-4:
		return INF
	var push := PUSH_FRAC * BODY_M * G * foot_load(h)
	if push <= 0.0:
		return 0.0
	return sqrt(2.0 * push / (RHO * CD * a))

## Глубина, на которой брод кончается и начинается плавание. Не выбрана:
## это глубина, где на ногах остаётся меньше пятой части веса.
static func swim_depth() -> float:
	var lo := 0.5
	var hi := BODY_H
	for _i in range(24):
		var mid := 0.5 * (lo + hi)
		if foot_load(mid) > 0.20:
			lo = mid
		else:
			hi = mid
	return 0.5 * (lo + hi)

## СКОРОСТЬ КРУГОВ ПО ВОДЕ. Волна на мелкой воде не дисперсна: гребень идёт со
## скоростью sqrt(g·d), где d — глубина под ним. Это то самое, что видно, когда
## от ноги расходится круг: у берега он медленнее, на глубине быстрее.
static func wave_speed(depth: float) -> float:
	return sqrt(G * maxf(depth, 0.02))

## Число Рейнольдса обтекания — им проверяется, что Cd взят из верного режима
static func reynolds(v: float, d: float) -> float:
	return v * d / NU

## Самопроверка числами: печатает то, что можно сверить с жизнью.
static func self_check() -> String:
	var s := "[вода-вещество] объём тела %.4f м³, вес %.0f Н\n" % [body_volume(), BODY_M * G]
	s += "  глубина | площадь | на ногах | предел брода | круги\n"
	for h in [0.15, 0.30, 0.45, 0.60, 0.90, 1.20, 1.35, 1.50]:
		s += "  %5.2f м | %5.3f м² | %5.0f%%   | %5.2f м/с    | %.2f м/с\n" \
			% [h, frontal_area(h), foot_load(h) * 100.0,
			minf(wade_speed(h), 9.9), wave_speed(h)]
	s += "  плавание начинается с %.2f м (на ногах остаётся 20%% веса)\n" % swim_depth()
	s += "  Re при 1 м/с и поперечнике 0.15 м: %.0f — турбулентный режим, Cd=%.1f" \
		% [reynolds(1.0, 0.15), CD]
	return s
