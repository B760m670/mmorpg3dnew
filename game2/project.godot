; Империя 1894 — пересоздание (Ф0). База: наш форк Godot 4.5.2 (Metal/MetalFX).
; Сборка: шаблоны run#3 (с MoltenVK.xcframework).
config_version=5

[application]
config/name="Империя 1894 — пересоздание"
run/main_scene="res://scenes/earth.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[autoload]
Core="*res://scripts/core/core.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=4

[rendering]
renderer/rendering_method="forward_plus"
textures/default_filters/anisotropic_filtering_level=2
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/use_debanding=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
