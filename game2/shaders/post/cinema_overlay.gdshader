shader_type canvas_item;
// Кино-пост как ПОЛНОЭКРАННЫЙ оверлей (фрагмент-шейдер) — надёжен на любом
// бэкенде, включая Metal. Читает уже отрисованный кадр через screen-texture.
//
// ЗАМЫСЕЛ: кадр — это не «вид глазами», а СНЯТЫЙ кадр. У съёмки есть оптика
// (хроматика, виньетка, засветка от источника в кадре) и есть носитель (зерно,
// которого в тенях больше, чем в светах). Это половина «кинематографичности» и
// стоит она один проход, а не миллион треугольников.

uniform sampler2D screen_tex : hint_screen_texture, filter_linear;
uniform float grain = 1.0;      // общий множитель зерна (0 — выключить)
uniform float vignette = 0.28;
uniform float ca = 0.0016;      // хроматика в долях экрана
uniform float t = 0.0;          // время для анимации зерна
// xy — экранные координаты Солнца (0..1), z — видимость 0..1 (над горизонтом,
// перед камерой, не съедено облаками). z = 0 полностью выключает засветку.
uniform vec3 sun_uv = vec3(0.5, 0.5, 0.0);
uniform float glare = 1.0;      // общий множитель засветки

// ЦЕЛОЧИСЛЕННЫЙ ХЕШ от FRAGCOORD.
//
// ЧЕСТНО ПРО ВЫИГРЫШ. Прежний хеш (Hoskins на fract) я проверил числами: на
// кадре 1280×720 автокорреляция обоих не выше 0.003 по всем сдвигам в окне ±8,
// то есть по «белизне» они НЕ РАЗЛИЧАЮТСЯ, и заявлять здесь улучшение картинки
// было бы выдумкой. Настоящая разница в другом: прежний брал uv×(1920,1080), и
// размер зерна ехал вместе с разрешением кадра — а у нас оно меняется (MetalFX,
// губернатор разрешения). FRAGCOORD даёт зерно ровно в один пиксель всегда.
float hash(vec2 p) {
	uvec2 q = uvec2(ivec2(p)) * uvec2(1597334673u, 3812015801u);
	uint n = (q.x ^ q.y) * 1597334673u;
	n = (n ^ (n >> 15u)) * 2246822519u;
	n = (n ^ (n >> 13u)) * 3266489917u;
	return float(n ^ (n >> 16u)) * (1.0 / 4294967295.0);
}

float luma(vec3 c) {
	return dot(c, vec3(0.299, 0.587, 0.114));
}

void fragment() {
	vec2 uv = SCREEN_UV;
	vec2 res = 1.0 / SCREEN_PIXEL_SIZE;
	float aspect = res.x / max(res.y, 1.0);
	vec2 c = uv - 0.5;
	float r2 = dot(c, c);

	// хроматическая аберрация к краям
	vec2 dir = (r2 > 1e-6) ? normalize(c) : vec2(0.0);
	vec2 sh = dir * ca * r2 * 2.0;
	vec3 col;
	col.r = texture(screen_tex, uv + sh).r;
	col.g = texture(screen_tex, uv).g;
	col.b = texture(screen_tex, uv - sh).b;

	// ВУАЛИРУЮЩАЯ ЗАСВЕТКА к Солнцу: полоса вдоль горизонтали, ореол и два
	// «призрака» по оптической оси. Это то, чего не даёт ни одна модель
	// освещения, потому что рождается не в мире, а в стекле объектива.
	//
	// ПЕРЕКРЫТИЕ ЧЕСТНОЕ, а не «сообщённое с процессора»: сила берётся из
	// яркости самого кадра в точке Солнца (4 отсчёта крестом). Зашло Солнце за
	// здание или за дерево — там темно, и засветка гаснет сама.
	if (sun_uv.z > 0.001 && glare > 0.001) {
		float o = 0.012;
		float sky = luma(texture(screen_tex, sun_uv.xy).rgb)
			+ luma(texture(screen_tex, sun_uv.xy + vec2(o, 0.0)).rgb)
			+ luma(texture(screen_tex, sun_uv.xy - vec2(o, 0.0)).rgb)
			+ luma(texture(screen_tex, sun_uv.xy + vec2(0.0, o)).rgb)
			+ luma(texture(screen_tex, sun_uv.xy - vec2(0.0, o)).rgb);
		float open = smoothstep(0.35, 0.85, sky * 0.2);
		float k = sun_uv.z * open * glare;
		if (k > 0.001) {
			vec2 sp = sun_uv.xy - uv;
			sp.x *= aspect;
			float dd = length(sp);
			float streak = exp(-abs(sp.y) * 60.0) * exp(-abs(sp.x) * 2.6);
			float halo = exp(-dd * 7.0) * 0.30 + exp(-dd * 1.7) * 0.045;
			vec3 veil = vec3(1.0, 0.93, 0.80) * (streak * 0.10 + halo);
			// ПРИЗРАКИ — ЭТО ОТРАЖЕНИЯ МЕЖДУ ЛИНЗАМИ, и лежат они на прямой
			// «источник — центр кадра», по ДРУГУЮ сторону от центра. В образце
			// они были посчитаны так, что оба садились ровно на само Солнце —
			// получалась синяя точка на диске, а не блик в стекле.
			vec2 axis = vec2(0.5) - sun_uv.xy;
			vec2 g1 = vec2(0.5) + axis * 0.42;
			vec2 g2 = vec2(0.5) + axis * 1.15;
			veil += vec3(0.35, 0.55, 0.75)
				* exp(-length((uv - g1) * vec2(aspect, 1.0)) * 16.0) * 0.09;
			veil += vec3(0.75, 0.42, 0.25)
				* exp(-length((uv - g2) * vec2(aspect, 1.0)) * 22.0) * 0.07;
			// Кадр к этому месту УЖЕ прошёл тонмаппинг, и складывать в нём
			// вуаль как в линейном — значит упереться в единицу и получить
			// плоское белое пятно. «Экранное» смешение выходит на единицу
			// плавно и не может пережечь.
			col = 1.0 - (1.0 - col) * exp(-veil * k);
		}
	}

	// виньетка
	col *= 1.0 - vignette * smoothstep(0.08, 0.5, r2);

	// ЗЕРНО СЕНСОРА: растёт там, где мало сигнала — ровно как на настоящей
	// матрице и на настоящей плёнке. Раньше множитель был линейный по яркости,
	// и зерно было заметно ровно там, где ему быть не следует, — в светах.
	float lum = luma(col);
	float n = hash(FRAGCOORD.xy + vec2(floor(t * 61.0), floor(t * 37.0))) - 0.5;
	col += n * grain * (0.012 + 0.034 * (1.0 - smoothstep(0.0, 0.26, lum)));

	COLOR = vec4(max(col, vec3(0.0)), 1.0);
}
