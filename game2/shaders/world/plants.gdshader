shader_type spatial;
// РАСТЕНИЕ — лист, а не картонка.
//
// ЦВЕТ ЛЕЖИТ В ВЕРШИНЕ. У травы цвет — свойство вида и части растения: лист
// злака темнее и холоднее, соцветие светлее и желтее, у разнотравья лист шире и
// светлее. Всё это уже испечено в вершинный цвет (tools/bake_plants.py), и
// текстуры для этого не нужно — она бы только тянула память и мылила лист.
//
// ДВУСТОРОННИЙ И ПОДСВЕЧЕННЫЙ НАСКВОЗЬ. Лист тонкий: часть света проходит
// через него и выходит с другой стороны. Именно это делает траву на просвет
// светящейся против солнца, и именно этого не хватало старой траве. Здесь
// пропускание задано долей от альбедо, а не отдельной краской.
render_mode cull_disabled, diffuse_burley, specular_disabled;

// Доля света, проходящая сквозь лист. Для тонкого зелёного листа это 5-15%
// в зелёном и меньше в синем: хлорофилл поглощает красное и синее, а зелёное
// пропускает — поэтому лист на просвет ЗЕЛЁНЫЙ ярче, чем в отражении.
uniform vec3 translucency = vec3(0.06, 0.22, 0.05);
// Насколько лист гнётся от ветра. Пока ветра нет — только слабое дыхание, чтобы
// покров не стоял мёртвой щёткой. Настоящее поле ветра — следующая работа.
uniform float sway = 0.06;

varying vec3 v_col;
varying float v_up;

void vertex() {
	v_col = COLOR.rgb;
	// НАКЛОН ТЕМ СИЛЬНЕЕ, ЧЕМ ВЫШЕ ТОЧКА НА РАСТЕНИИ: корень не двигается,
	// кончик ходит. Это не «шум по всей сетке», а изгиб стебля.
	float h = max(VERTEX.y, 0.0);
	v_up = clamp(h * 3.0, 0.0, 1.0);
	vec3 w = (MODEL_MATRIX * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
	float ph = w.x * 0.7 + w.z * 0.9;
	VERTEX.x += sin(TIME * 1.1 + ph) * sway * h;
	VERTEX.z += cos(TIME * 0.8 + ph * 1.3) * sway * h * 0.7;
}

void fragment() {
	ALBEDO = v_col;
	// ЗЕМЛЯ У КОРНЯ ТЕМНЕЕ: внутрь дернины свет почти не доходит. Без этого
	// покров выглядит равномерно яркой щёткой и не читается как объём.
	ALBEDO *= mix(0.45, 1.0, v_up);
	ROUGHNESS = 0.85;
	SPECULAR = 0.2;
	BACKLIGHT = translucency;
	// лист двусторонний: нормаль всегда к наблюдателю, иначе половина листьев
	// чёрная
	NORMAL = FRONT_FACING ? NORMAL : -NORMAL;
}
