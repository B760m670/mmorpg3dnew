shader_type spatial;
// ВОДА, КОТОРАЯ СОЗДАЁТСЯ, А НЕ РИСУЕТСЯ.
//
// ЧТО БЫЛО НЕВЕРНО ДО ЭТОГО. Вода имела СОБСТВЕННЫЙ ЦВЕТ (uniform tint) и
// СОБСТВЕННОЕ ДНО (uniform bottom_color + картинка bottom_tex). То есть это
// была крашеная плёнка с настроенной прозрачностью: сколько ни правь оттенок,
// сквозь неё не видно НАСТОЯЩЕГО дна, и в ней не отражается НАСТОЯЩЕЕ небо.
// Волны тут ни при чём — рябь ничего бы не исправила, потому что нечему
// преломляться и нечему отражаться.
//
// ЧТО ДЕЛАЕТ ВОДУ ВОДОЙ. Вода — не поверхность, а ГРАНИЦА ДВУХ СРЕД. На ней
// свет РАЗДЕЛЯЕТСЯ на две доли, и обе берутся ИЗ САМОЙ СЦЕНЫ:
//   ПРЕЛОМЛЁННАЯ доля — это пиксели уже нарисованного мира ПОД водой
//     (SCREEN_TEXTURE), сдвинутые по закону Снелля и ослабленные толщей.
//     Никакого «цвета воды» не задаётся: сине-зелёный ВОЗНИКАЕТ из того, что
//     красный свет тонет в первом метре, а синий проходит десятки метров.
//   ОТРАЖЁННАЯ доля — тоже пиксели этого же кадра, найденные трассировкой
//     отражённого луча ПО ЭКРАНУ: берег, деревья, дворец, а выше горизонта —
//     настоящее небо с облаками. Не «цвет отражения», а сам кадр.
// Доли делит ФРЕНЕЛЬ: сверху отражается 2%, вдоль поверхности — больше
// половины. Это и есть переход «прозрачно у ног — зеркало вдали».
//
// ПОЧЕМУ ОТРАЖЕНИЕ ПРИШЛОСЬ СЧИТАТЬ САМИМ. ИЗМЕРЕНО на стенде: если поставить
// на месте воды ИДЕАЛЬНОЕ ЗЕРКАЛО (METALLIC=1, ROUGHNESS=0, SPECULAR=1) и
// снять кадр, оно выходит ЧЁРНЫМ — 0.03..0.09 при небе 0.75. Значит движок не
// даёт прозрачным (blend) поверхностям ни карты излучения неба, ни зондов
// отражения: у них работает только ПРЯМОЙ свет. Сколько ни задавай Френель,
// отражать было НЕЧЕГО — и вода неизбежно читалась как крашеная плёнка. Это
// и есть та «половина воды», которой не было.
//
// ИЗМЕРЕННЫЕ ВЕЛИЧИНЫ, а не подобранные:
//   поглощение (Pope & Fry 1997), 1/м:  R 0.3400  G 0.0638  B 0.0145;
//   показатель преломления n = 1.333 → R0 = ((n-1)/(n+1))^2 = 0.0200;
//   Godot берёт отражение диэлектрика как f0 = 0.16·SPECULAR², значит
//     SPECULAR = sqrt(0.02/0.16) = 0.354 (а не 0.5 по умолчанию, что дало бы
//     f0 = 0.04 — вдвое зеркальнее настоящей воды);
//   уклон ряби (Cox & Munk 1954, по бликам Солнца на воде):
//     средний квадрат уклона = 0.003 + 0.00512·U, при U = 4 м/с → СКО 0.153.
//
// ЧЕГО ЗДЕСЬ НЕТ (честный список дефектов):
//   1. Отражение — экранное: отражается только то, что ВИДНО в кадре. Предмет
//      за спиной камеры в воде не отразится. Полное отражение требует второго
//      прохода камеры, а на устройстве сейчас 13 кадров/с.
//   2. Нет пены у кромки и вокруг препятствий.
//   3. Вода НЕПОДВИЖНА. Плотности, вязкости, текучести здесь нет — и не может
//      быть, пока воду нечем возмутить: у стоячего пруда решение уравнений
//      движения есть плоская неподвижная поверхность, то есть ровно то, что
//      здесь и нарисовано. Вязкость станет видна, когда в воду войдёт нога или
//      упадёт камень: тогда нужен решатель мелкой воды (высотное поле,
//      волновое уравнение на сетке, на GPU). Это отдельная работа, и она
//      бессмысленна до персонажа.
//   4. Рябь — не волны. У пруда волн нет: при разгоне 700 м и ветре 4 м/с это
//      сантиметры. Здесь рябь вообще не имеет высоты, она только НАКЛОНЯЕТ
//      зеркало. Совсем без неё вода была бы идеальным стеклом — тоже неправда.
render_mode blend_mix, depth_draw_never, cull_back, specular_schlick_ggx;

// --- ВЕЩЕСТВО ВОДОЁМА (озеро и река — разные вещества) ---
uniform float turbidity = 0.35;                 // 0 родник .. 1 цветущее озеро
// Альбедо взвеси в ЛИНЕЙНЫХ единицах (не source_color: тот пересчитал бы
// значения из sRGB и увёл планктон в почти чёрный 0.01..0.05).
uniform vec3 scatter_color = vec3(0.12, 0.30, 0.26);
uniform float flow_scale = 1.0;                 // 0 стоячая (озеро) .. 1 проточная
uniform float wind_ms = 4.0;                    // скорость ветра, м/с
uniform float wind_deg = 250.0;                 // откуда дует, градусы

// --- сцена ---
uniform sampler2D screen_tex : hint_screen_texture, filter_linear_mipmap;
uniform sampler2D depth_tex : hint_depth_texture, filter_nearest;
uniform sampler2D flow_tex : filter_linear, repeat_disable;   // RG=направление, B=скорость
uniform float dem_half = 8192.0;

// МАСКА ВОДЫ ПАРКА (метровый растр, 1 = вода). Рисуем воду по контуру озера из
// внешних данных, но ГДЕ вода на самом деле — знает наш растр, и они расходятся:
// ИЗМЕРЕНО по Белому озеру — 19 888 м² (5.1% контура) лежали ВЫШЕ земли плёнкой
// толщиной в среднем полметра. На устройстве это читалось как «жидкость на
// траве». Маска обрезает воду по нашему растру; линейная фильтрация даёт
// кромку шириной в метр, то есть заодно и мягкий берег.
uniform sampler2D park_mask : filter_linear, repeat_disable;
uniform float park_cx = 0.0;
uniform float park_cy = 400.0;
uniform float park_half = 0.0;

// КРУГИ ОТ ВОЗМУЩЕНИЙ: x, z, возраст в секундах, амплитуда в метрах.
// Это единственное место, где вода ДВИЖЕТСЯ не от ветра, а от того, что в неё
// вошли. Круг здесь не картинка и не «эффект»: гребень идёт со скоростью
// sqrt(g·d) — решение волнового уравнения для мелкой воды, где d берётся
// ИЗ ИЗМЕРЕННОЙ ТОЛЩИ под самим пикселем. Поэтому у берега круг медленнее, чем
// на глубине, сам собой.
uniform vec4 ripples[6];
const float RIP_LIFE = 4.0;      // с
const float RIP_LAM = 0.42;      // м, длина волны от шага человека

// измеренные коэффициенты поглощения чистой воды (Pope & Fry 1997), 1/м
const vec3 ABSORB = vec3(0.3400, 0.0638, 0.0145);
// показатель преломления воды и вытекающее из него отражение по нормали
const float IOR = 1.333;

varying vec3 v_world;

// --- РЯБЬ: пять направленных волн с НЕСОИЗМЕРИМЫМИ длинами -----------------
// Несоизмеримость важна: две волны с кратными длинами складываются в решётку,
// которая муарит вдаль (именно это и было видно на кадре раньше). Отношение
// длин здесь около 1/φ = 0.618 — золотое сечение, наихудшее приближение
// рациональным числом, поэтому сумма не повторяется на видимых масштабах.
const int NRIP = 9;
const float LAM[9] = {3.20, 2.30, 1.66, 1.19, 0.86, 0.62, 0.45, 0.32, 0.23};
// Направления РАЗБРОСАНЫ вокруг ветра. Пять волн одного направления давали
// «гофрированное железо» — видно на кадре. Разброс до ±1.2 рад и несоизмеримые
// шаги по углу разбивают правильность.
const float DIR[9] = {0.07, -0.83, 0.51, -0.29, 1.14, -1.07, 0.34, -0.62, 0.92};
// Доля уклона на каждую компоненту. Уклон = k·a; при спектре с ограниченным
// разгоном энергия падает к коротким волнам, а уклон при этом растёт — сумма
// весов даёт 1, распределение близко к равномерному по уклону.
const float WGT[9] = {0.08, 0.09, 0.10, 0.11, 0.12, 0.12, 0.13, 0.12, 0.13};

// Уклон поверхности (dh/dx, dh/dz) от суммы ряби. Возвращает уклон, а не
// высоту: для оптики нужна только НОРМАЛЬ.
//
// ПОКОМПОНЕНТНЫЙ ОТСЕВ ПО РАЗМЕРУ ПИКСЕЛЯ (px — сколько метров в одном пикселе
// на этом расстоянии). Компонента, которая стала мельче нескольких пикселей,
// не рисуется: её нельзя разрешить, и попытка даёт мерцание и муар. Её уклон
// не выбрасывается, а возвращается наружу как ПОТЕРЯННАЯ ДИСПЕРСИЯ и уходит в
// шероховатость — микрограни с тем же распределением уклонов. Физически это
// то же самое, только считается статистически, а не поштучно.
vec2 ripple_slope(vec2 p, float t, vec2 flow, float rms, float px, out float lost) {
	float wdir = radians(wind_deg);
	vec2 s = vec2(0.0);
	lost = 0.0;
	for (int i = 0; i < NRIP; i++) {
		float a = wdir + DIR[i];
		vec2 d = vec2(cos(a), sin(a));
		float k = 6.28318530718 / LAM[i];
		// дисперсия волн на глубокой воде: ω = sqrt(g·k)
		float w = sqrt(9.81 * k);
		// течение сносит рябь: фаза дополнительно сдвигается по потоку
		float ph = k * dot(p - flow * t, d) - w * t;
		float amp = rms * WGT[i] * 3.0;
		float vis = smoothstep(3.0 * px, 7.0 * px, LAM[i]);
		s += d * (amp * vis * cos(ph));
		lost += amp * amp * 0.5 * (1.0 - vis * vis);
	}
	return s;
}

// УКЛОН ОТ РАСХОДЯЩИХСЯ КРУГОВ.
// Волна на мелкой воде не дисперсна: весь цуг идёт одной скоростью c=sqrt(g·d),
// поэтому фронт находится ровно на r = c·t. За фронтом тянется короткий цуг.
// Амплитуда падает как 1/sqrt(r): энергия кольца сохраняется, а длина кольца
// растёт пропорционально r. Это не подгонка, это закон сохранения.
vec2 ripple_disturb(vec2 p, float depth, float px) {
	float c = sqrt(9.81 * clamp(depth, 0.02, 4.0));
	float k = 6.28318530718 / RIP_LAM;
	// круг мельче нескольких пикселей рисовать нельзя — будет мерцать
	float vis = smoothstep(2.0 * px, 6.0 * px, RIP_LAM);
	if (vis <= 0.0) { return vec2(0.0); }
	vec2 s = vec2(0.0);
	for (int i = 0; i < 6; i++) {
		float age = ripples[i].z;
		float amp = ripples[i].w;
		if (age >= RIP_LIFE || amp <= 0.0) { continue; }
		vec2 d = p - ripples[i].xy;
		float r = length(d);
		if (r < 0.001) { continue; }
		float front = c * age;
		float dr = front - r;                     // положительно ЗА фронтом
		// длина цуга растёт со временем: короткий всплеск расплывается
		float train = RIP_LAM * (1.5 + age * 1.2);
		if (dr < 0.0 || dr > train) { continue; }
		float env = amp / sqrt(max(r, 0.25))
			* (1.0 - dr / train)                  // хвост цуга затухает
			* (1.0 - age / RIP_LIFE);             // вязкость съедает круг
		s += (d / r) * (env * k * cos(k * dr) * vis);
	}
	return s;
}

void vertex() {
	v_world = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	// ВЫСОТЫ ВОЛН НЕТ НАМЕРЕННО. По разгону (Белое озеро, 700 м, 4 м/с) волна
	// здесь 9-12 см. На расстоянии 5 м это меньше пикселя силуэта, зато сетка
	// вершин клипмапа делает из неё видимую решётку. Оптике нужен наклон, а
	// наклон даёт fragment(). Высота вернётся только если появится берег с
	// накатом, где её видно.
}

// Точное френелевское отражение неполяризованного света на границе воздух-вода.
// Приближение Шлика годилось бы (ошибка < 0.06), но точная формула тут стоит
// десяток операций и снимает вопрос.
float fresnel_exact(float cos_i) {
	float s2 = (1.0 - cos_i * cos_i) / (IOR * IOR);
	if (s2 >= 1.0) { return 1.0; }               // полное внутреннее отражение
	float cos_t = sqrt(1.0 - s2);
	float rs = (cos_i - IOR * cos_t) / (cos_i + IOR * cos_t);
	float rp = (IOR * cos_i - cos_t) / (IOR * cos_i + cos_t);
	return clamp(0.5 * (rs * rs + rp * rp), 0.0, 1.0);
}

// Положение в пространстве вида по экранной координате и глубине.
// Godot 4 рисует через Vulkan: NDC по Z уже в [0..1], пересчёта из [-1..1] быть
// НЕ ДОЛЖНО. Из-за такого лишнего пересчёта толща воды выходила нулевой и вода
// не рисовала ни одного пикселя (проверено сравнением кадров: 0.00% различий).
vec3 view_from_depth(vec2 uv, float d, mat4 inv_proj) {
	vec4 p = inv_proj * vec4(uv * 2.0 - 1.0, d, 1.0);
	return p.xyz / p.w;
}

// НЕБО ДЛЯ ОТРАЖЕНИЯ, КОГДА ЭКРАН НЕ ЗНАЕТ ОТВЕТА.
// Сначала ищем НАСТОЯЩЕЕ небо в самом кадре: три пробы сверху вниз по тому же
// столбцу пикселей. Небо узнаётся по буферу глубины — там, где ничего не
// нарисовано, глубина нулевая. Это даёт настоящее небо игры вместе с облаками.
// ИЗМЕРЕНО, что было неверно: раньше проба была одна и БЕЗ проверки глубины —
// просто «верх кадра». Стоило посмотреть вниз, на воду у ног, как верхом кадра
// оказывалась трава дальнего берега, и она красила всю воду.
// Если неба в кадре нет вовсе (смотрим круто вниз), берём заданный снаружи
// двухцветный купол. Это ГРУБАЯ замена, и она допустима только здесь: при
// взгляде вниз Френель даёт 2-10%, то есть отражение почти ничего не весит.
uniform vec3 sky_horizon = vec3(0.55, 0.60, 0.68);
uniform vec3 sky_zenith = vec3(0.35, 0.45, 0.65);

vec3 sky_probe(float col_u, float ray_up, sampler2D scr, sampler2D dep) {
	for (int i = 0; i < 3; i++) {
		vec2 uv = vec2(col_u, 0.02 + float(i) * 0.07);
		if (textureLod(dep, uv, 0.0).r <= 0.0001) {
			return textureLod(scr, uv, 3.0).rgb;
		}
	}
	return mix(sky_horizon, sky_zenith, sqrt(clamp(ray_up, 0.0, 1.0)));
}

// --- ОТРАЖЕНИЕ ТРАССИРОВКОЙ ПО ЭКРАНУ ------------------------------------
// Идём вдоль отражённого луча в пространстве вида, на каждом шаге проецируем
// точку на экран и сравниваем её глубину с глубиной сцены. Как только луч
// оказался ЗА поверхностью сцены — это пересечение, и цвет отражения берётся
// из уже нарисованного кадра. Шаг растёт геометрически: вблизи нужна точность,
// вдали — дальнобойность (20 шагов от 0.4 м с ростом 1.35 дают около 400 м).
//
// ЕСЛИ ПЕРЕСЕЧЕНИЯ НЕТ — луч ушёл выше горизонта, то есть в НЕБО. Тогда берём
// пиксель кадра там, где луч покинул экран: это и есть настоящее небо этой
// игры, с облаками и с Солнцем. Отдельной «краски неба» не нужно.
vec3 trace_reflection(vec3 ro, vec3 rd, sampler2D scr, sampler2D dep,
		mat4 proj, mat4 inv_proj, vec3 fallback, float lod) {
	const int STEPS = 20;
	float t = 0.4;
	float step_len = 0.4;
	vec2 last_uv = vec2(0.5);
	bool have_last = false;
	for (int i = 0; i < STEPS; i++) {
		vec3 p = ro + rd * t;
		if (p.z > -0.05) { break; }               // луч ушёл за камеру
		vec4 c = proj * vec4(p, 1.0);
		vec2 uv = (c.xy / c.w) * 0.5 + 0.5;
		if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) { break; }
		last_uv = uv;
		have_last = true;
		float d = textureLod(dep, uv, 0.0).r;
		if (d > 0.0001 && d < 0.9999) {
			float sz = view_from_depth(uv, d, inv_proj).z;
			float behind = sz - p.z;              // >0: луч зашёл за поверхность
			// ТОЛЩИНА ПРОВЕРКИ — С ЖЁСТКИМ ПОТОЛКОМ.
			// ИЗМЕРЕНО НА УСТРОЙСТВЕ (снимки пешехода у воды): допуск был равен
			// длине шага, а шаг растёт в 1.35 раза и к концу доходит до ~90 м.
			// На таком допуске ЛЮБОЙ далёкий силуэт, мимо края которого луч
			// прошёл, засчитывался попаданием — в воде появлялись искривлённые
			// здания, которых перед камерой нет вовсе, и они ехали при повороте.
			// Потолок 3 м — это настоящая толщина стены/дерева; всё, что «за»
			// дальше, луч прошёл МИМО, а не попал.
			if (behind > 0.0 && behind < min(step_len, 3.0) + 0.25) {
				// уточнение делением пополам — без него ступеньки видны
				float lo = t - step_len;
				float hi = t;
				for (int k = 0; k < 4; k++) {
					float mid = 0.5 * (lo + hi);
					vec3 pm = ro + rd * mid;
					vec4 cm = proj * vec4(pm, 1.0);
					vec2 um = (cm.xy / cm.w) * 0.5 + 0.5;
					float dm = textureLod(dep, um, 0.0).r;
					float szm = view_from_depth(um, dm, inv_proj).z;
					if (szm - pm.z > 0.0) { hi = mid; } else { lo = mid; }
					last_uv = um;
				}
				// КРАЙ ЭКРАНА: у самой рамки отражение обрывается, и обрыв
				// заметен. Плавно уводим его в небо.
				vec2 e = smoothstep(vec2(0.0), vec2(0.12), last_uv)
					* (1.0 - smoothstep(vec2(0.88), vec2(1.0), last_uv));
				float edge = e.x * e.y;
				return mix(fallback, textureLod(scr, last_uv, lod).rgb, edge);
			}
		}
		step_len *= 1.35;
		t += step_len;
	}
	// ПЕРЕСЕЧЕНИЯ НЕТ — значит луч ушёл в небо или за край кадра, и в обоих
	// случаях экран о нём НИЧЕГО не знает.
	// ИЗМЕРЕНО, что было неверно: тут возвращался ПОСЛЕДНИЙ пиксель, на котором
	// луч ещё был в кадре. У боковой кромки это земля или дом — и они
	// размазывались вдоль края экрана, а при повороте камеры ехали по воде.
	// Пиксель на краю кадра не имеет никакого отношения к тому, что отразилось.
	return fallback;
}

void fragment() {
	// --- НАКЛОН ПОВЕРХНОСТИ ---
	// Средний квадрат уклона по Cox & Munk (1954): измерен по бликам Солнца на
	// воде с самолёта, связывает ветер и шероховатость воды напрямую.
	float mss = 0.003 + 0.00512 * wind_ms;
	float rms_slope = sqrt(mss);

	// течение по настоящей карте уклонов (build_flowmap.py)
	vec2 fuv = (v_world.xz + vec2(dem_half)) / (2.0 * dem_half);
	vec4 fl = texture(flow_tex, clamp(fuv, 0.0, 1.0));
	vec2 flow = (fl.rg * 2.0 - 1.0) * fl.b * 2.0 * flow_scale;

	float dist = max(-VERTEX.z, 0.5);            // расстояние до пикселя, м
	// СКОЛЬКО МЕТРОВ В ОДНОМ ПИКСЕЛЕ на этом расстоянии. Считается из матрицы
	// проекции и размера кадра, а не подбирается: 1/P[1][1] = tg(полуугла),
	// значит высота кадра в метрах = 2·dist/P[1][1], делим на число строк.
	// Это единственная честная мера того, что экран ещё способен разрешить.
	float px = 2.0 * dist / (PROJECTION_MATRIX[1][1] * VIEWPORT_SIZE.y);
	float lost = 0.0;
	vec2 sl = ripple_slope(v_world.xz, TIME, flow, rms_slope, px, lost);
	vec3 n_world = normalize(vec3(-sl.x, 1.0, -sl.y));

	vec3 vdir = normalize(v_world - CAMERA_POSITION_WORLD);
	float cos_i = clamp(dot(-vdir, n_world), 0.0, 1.0);

	// --- ТОЛЩА ВОДЫ ПОД ПИКСЕЛЕМ ---
	// Дно — это уже нарисованный рельеф в буфере глубины, а не заданное число.
	float scene_d = texture(depth_tex, SCREEN_UV).r;
	bool depth_ok = scene_d > 0.0001 && scene_d < 0.9999;
	// ЗАПАСНАЯ ТОЛЩА, если буфера глубины нет (например мобильный рендер): без
	// неё вода становилась НЕВИДИМОЙ. Промеры Белого озера: 1.4-3.5 м.
	float d_ray = 2.0;
	if (depth_ok) {
		vec3 p_bottom = view_from_depth(SCREEN_UV, scene_d, INV_PROJECTION_MATRIX);
		d_ray = max(0.0, length(p_bottom) - length(VERTEX));   // вдоль луча, м
	}
	float d_vert = d_ray * abs(vdir.y);          // вертикальная толща, м

	// КРУГИ ОТ ТОГО, ЧТО В ВОДУ ВОШЛИ. Считаются здесь, а не выше, потому что
	// скорость круга зависит от ТОЛЩИ, а толща стала известна только сейчас.
	sl += ripple_disturb(v_world.xz, d_vert, px);
	n_world = normalize(vec3(-sl.x, 1.0, -sl.y));
	cos_i = clamp(dot(-vdir, n_world), 0.0, 1.0);

	// --- ПРЕЛОМЛЕНИЕ: сдвиг того, что видно сквозь воду ---
	// Снелль: при малом наклоне поверхности луч уходит вбок на
	//   L ≈ толща · (1 - 1/n) · уклон ≈ толща · 0.25 · уклон.
	// Метры переводим в экранные координаты через матрицу проекции, а не
	// подбором: сдвиг на экране = L·P[i][i]/расстояние, и ещё /2 из NDC в UV.
	vec2 lat = -sl * (1.0 - 1.0 / IOR) * min(d_vert, 4.0);
	vec2 uv_off = vec2(lat.x * PROJECTION_MATRIX[0][0],
	                   lat.y * PROJECTION_MATRIX[1][1]) * 0.5 / dist;
	vec2 ruv = clamp(SCREEN_UV + uv_off, vec2(0.001), vec2(0.999));
	// ЗАЩИТА ОТ ПРОТЕЧКИ: если по сдвинутой координате оказался предмет БЛИЖЕ
	// воды (нога игрока, свая, лодка), его нельзя размазывать сквозь воду —
	// берём несдвинутую координату. Без этой проверки предметы перед водой
	// «затягивает» в неё, и это сразу читается как подделка.
	float rd = texture(depth_tex, ruv).r;
	if (rd > scene_d + 0.00002) { ruv = SCREEN_UV; }

	// МУТНОСТЬ РАЗМЫВАЕТ ДНО. Взвесь рассеивает свет, и дно теряет резкость
	// тем сильнее, чем толще слой — это рассеяние, а не «блюр для красоты».
	float lod = clamp(d_vert * turbidity * 0.7, 0.0, 4.0);
	vec3 seen = textureLod(screen_tex, ruv, lod).rgb;

	// --- ПОГЛОЩЕНИЕ (Бугер-Ламберт-Бер) ---
	// Путь света: от неба вниз (вертикальная толща) и от дна к глазу (вдоль
	// луча). Сумма этих двух путей, а не «толща×2» наугад.
	vec3 trans = exp(-ABSORB * (d_vert + d_ray));
	// доля света, перехваченная взвесью на этом же пути
	float murk = 1.0 - exp(-turbidity * (d_vert + d_ray) * 0.45);

	float F = fresnel_exact(cos_i);

	// --- ОТРАЖЕНИЕ ---
	// ОТРАЖЁННЫЙ ЛУЧ строим в мире, чтобы проверить его по горизонту.
	// ИЗМЕРЕНО, зачем: при скользящем взгляде рябь наклоняет нормаль сильнее,
	// чем сам угол зрения (уклон 0.15 рад против 0.01 рад), и отражённый луч
	// у половины граней уходит ВНИЗ, В ВОДУ. Трассир ловил там берег и дно —
	// на кадре это были жёлтые и чёрные крапины по всей глади. Физически такие
	// грани отвёрнуты от наблюдателя и не видны вовсе; поднимаем луч до
	// горизонта, а не «фильтруем шум».
	vec3 rw = reflect(vdir, n_world);
	if (rw.y < 0.03) { rw = normalize(vec3(rw.x, 0.03, rw.z)); }

	// НЕБО — единственный законный ответ там, где экран не знает отражения.
	vec3 sky_est = sky_probe(SCREEN_UV.x, rw.y, screen_tex, depth_tex);

	// ШЕРОХОВАТОСТЬ — это ровно тот уклон ряби, который экран уже не разрешает
	// (сумма потерянных компонент, посчитанная выше). Не подобранное число:
	// вблизи всё разрешено и вода гладкая, вдали вся рябь ушла сюда.
	ROUGHNESS = clamp(sqrt(lost) + 0.02, 0.02, 0.4);
	// шероховатое зеркало размывает отражение — берём более грубый мипмап
	float refl_lod = clamp(ROUGHNESS * 12.0, 0.0, 4.0);

	vec3 rdir = normalize((VIEW_MATRIX * vec4(rw, 0.0)).xyz);
	vec3 refl = trace_reflection(VERTEX, rdir, screen_tex, depth_tex,
		PROJECTION_MATRIX, INV_PROJECTION_MATRIX, sky_est, refl_lod);

	// --- СБОРКА ---
	// Обе доли — УЖЕ ОСВЕЩЁННЫЕ пиксели кадра, их нельзя класть в ALBEDO (свет
	// применился бы дважды). Они идут в EMISSION как готовая яркость.
	// Взвесь освещается небом: её светимость = альбедо взвеси × яркость неба.
	// Раньше взвесь лежала в ALBEDO и должна была освещаться движком — но у
	// прозрачных поверхностей рассеянного света нет (см. замер зеркала выше),
	// и в пасмурность взвесь оставалась чёрной.
	vec3 under = seen * trans * (1.0 - murk) + scatter_color * murk * sky_est;
	EMISSION = under * (1.0 - F) + refl * F;
	ALBEDO = vec3(0.0);        // вода не диффузна: у неё нет собственного цвета
	NORMAL = normalize((VIEW_MATRIX * vec4(n_world, 0.0)).xyz);
	METALLIC = 0.0;
	// f0 = 0.16·SPECULAR² (формула Godot) → SPECULAR = 0.354 даёт ровно 0.02,
	// измеренное отражение воды по нормали. От движка нам нужен ровно один
	// вклад — ПРЯМОЙ блик Солнца (дорожка на воде); он единственный, что до
	// прозрачных поверхностей доходит.
	SPECULAR = 0.354;
	// ОБРЕЗКА ПО НАШЕМУ РАСТРУ. Вне окна парка (park_half = 0) маски нет и вода
	// рисуется как раньше. Внутри — вода кончается там, где её нет по растру.
	float a = 1.0;
	if (park_half > 0.0) {
		vec2 muv = vec2((v_world.x - park_cx + park_half),
		                (park_cy + park_half + v_world.z)) / (2.0 * park_half);
		if (muv.x > 0.0 && muv.x < 1.0 && muv.y > 0.0 && muv.y < 1.0) {
			a = smoothstep(0.30, 0.70, texture(park_mask, muv).r);
		}
	}
	// прозрачность даёт преломление; альфа тут — только граница водоёма
	ALPHA = a;
}
